{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuwenying1003-lang.github.io/podcast-youci-library/docs/course.schema.json",
  "title": "Podcast Youci course",
  "type": "object",
  "required": ["meta", "units", "vocab", "expressions", "patterns"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["episodeId", "title", "verified"],
      "properties": {
        "episodeId": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "title": {"type": "string", "minLength": 1},
        "verified": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "pattern": "^https://app\\.listenleap\\.com/read\\?id="},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end", "title", "preview", "question"],
        "properties": {
          "start": {"$ref": "#/$defs/time"},
          "end": {"$ref": "#/$defs/time"},
          "title": {"type": "string", "minLength": 1},
          "preview": {"type": "string", "minLength": 1},
          "recap_zh": {"type": "string", "minLength": 1},
          "transcript_pages": {
            "type": "array",
            "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
            "minItems": 2,
            "maxItems": 2
          },
          "question": {"type": "string", "minLength": 1}
        }
      }
    },
    "vocab": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learningItem"}},
    "expressions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learningItem"}},
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/speakingPattern"}}
    }
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]+:[0-5][0-9]$"},
    "clip": {
      "type": "object",
      "required": ["start", "end", "verified", "quote"],
      "properties": {
        "start": {"$ref": "#/$defs/time"},
        "end": {"$ref": "#/$defs/time"},
        "verified": {"const": true},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "learningItem": {
      "type": "object",
      "properties": {
        "clip": {"$ref": "#/$defs/clip"},
        "source_page": {"type": "integer", "minimum": 1},
        "source_segment": {"type": "string", "minLength": 1},
        "source_excerpt": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["original", "teaching"]},
        "source_verification": {"type": "string", "minLength": 1},
        "extraction_confidence": {"enum": ["high", "medium", "low"]},
        "editorial_status": {"type": "string", "minLength": 1},
        "ipa_source": {"type": "string", "minLength": 1},
        "ipa_status": {"type": "string", "minLength": 1},
        "definition_source": {"type": "string", "minLength": 1},
        "definition_status": {"type": "string", "minLength": 1}
      }
    },
    "speakingScenario": {
      "type": "object",
      "required": ["type", "label", "scene_zh", "goal_en", "keywords", "starter", "reference_answer"],
      "properties": {
        "type": {"enum": ["daily", "social", "work"]},
        "label": {"type": "string", "minLength": 1},
        "scene_zh": {"type": "string", "minLength": 10},
        "goal_en": {"type": "string", "minLength": 5},
        "keywords": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
        "starter": {"type": "string", "minLength": 2},
        "reference_answer": {"type": "string", "minLength": 5}
      },
      "additionalProperties": false
    },
    "speakingPattern": {
      "type": "object",
      "required": ["text", "cn", "example", "prompt", "scenarios"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "cn": {"type": "string", "minLength": 1},
        "example": {"type": "string", "minLength": 5},
        "prompt": {"type": "string", "minLength": 5},
        "scenarios": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/speakingScenario"}}
      }
    }
  }
}
